APP_ENV=local
DATABASE_URL=postgresql+psycopg://saathi:saathi@localhost:5432/saathi
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ISSUER=paytm-saathi
ACCESS_TOKEN_MINUTES=15
REDIS_URL=redis://localhost:6379/0
PROVIDER_MODE=sandbox
SUPABASE_URL=
SUPABASE_ANON_KEY=
CORS_ORIGINS=["http://localhost:3000"]
AI_API_BASE_URL=https://api.sarvam.ai/v1
AI_API_KEY=
AI_MODEL=sarvam-105b-conversations
# Optional Telegram language understanding provider. Qwen takes priority when its key is configured.
QWEN_API_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=
QWEN_MODEL=qwen-plus
# Only add organization IDs after the merchant has explicitly consented to provider processing.
AI_DATA_CONSENT_ORGANIZATION_IDS=[]
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Leave blank for local long polling. Set an HTTPS webhook endpoint when deploying.
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
